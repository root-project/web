{%- assign sorted = site.releases | reverse -%}
{%- for release in sorted -%}
   {%- if release.state == "latest" -%}
      {%- assign parts = release.content | split: '/x86_64-almalinux9' -%}
      {%- if parts.size > 1 -%}
         x86_64-almalinux9{{ parts[1] | newline_to_br | split: '<br />' | first | strip }}
      {%- else -%}
         {%- assign parts = release.content | split: '/x86_64-' -%}
         {%- if parts.size > 1 -%}
            x86_64-{{ parts[1] | newline_to_br | split: '<br />' | first | strip }}
         {%- endif -%}
      {%- endif -%}
   {%- endif -%}
{%- endfor -%}